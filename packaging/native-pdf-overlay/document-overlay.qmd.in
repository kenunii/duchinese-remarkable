AFFECT /qml/device/view/documentview/DocumentView.qml
    TRAVERSE FocusScope#root > Item#_uiContainer > Toolbar#toolbar
        LOCATE AFTER ALL
        INSERT {
            chineseDocumentId: root.document ? String(root.document.id) : ""
        }
    END TRAVERSE

    TRAVERSE FocusScope#root
        LOCATE AFTER ALL
        INSERT {
            Loader {
                id: duchinesePdfOverlay
                anchors.fill: parent
                z: 100001
                active: root.document !== null && root.document.fileType === Document.Pdf
                source: "qrc:/duchinese-pdf-overlay/LookupOverlay.qml"
                onLoaded: {
                    item.nativeSceneView = sceneView;
                    item.documentId = Qt.binding(function() {
                        return root.document ? String(root.document.id) : "";
                    });
                    // Notebook positions include inserted notes and reordered pages.
                    // Lookup data is indexed by the original PDF page instead.
                    item.pageIndex = Qt.binding(function() {
                        if (!root.document || root.currentPage < 0) return -1;
                        var page = root.document.redirectionPageMap[root.currentPage];
                        return typeof page === "number" && page >= 0 ? page : -1;
                    });
                    console.log("[PDF lookup] overlay loaded for prepared PDF");
                }
            }
        }
    END TRAVERSE
END AFFECT

AFFECT /qt/qml/xofm/libs/toolbar/qml/Toolbar.qml
    TRAVERSE FocusScope#root
        LOCATE AFTER ALL
        INSERT {
            property string chineseDocumentId: ""
        }
    END TRAVERSE
END AFFECT

AFFECT /qt/qml/xofm/libs/toolbar/qml/SettingsMenu.qml
    TRAVERSE ToolbarTool#root > Component#settingsComponent > ColumnLayout#content
        LOCATE AFTER ALL
        INSERT {
            Loader {
                Layout.fillWidth: true
                active: root.documentType === "pdf"
                visible: active
                source: "qrc:/duchinese-pdf-overlay/ProcessMenuItem.qml"
                onLoaded: {
                    item.documentId = Qt.binding(function() { return root.toolbar.chineseDocumentId; });
                }
            }
        }
    END TRAVERSE
END AFFECT
